#!/usr/bin/env bash

set -Eeuo pipefail

BSPWM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/bspwm"
if [[ -r "$BSPWM_DIR/local.env" ]]; then
  # shellcheck source=/dev/null
  source "$BSPWM_DIR/local.env"
fi

terminal="${BSPWM_TERMINAL:-alacritty}"
window_class=bspwm-terminal
declare -a child_command=()

if [[ "${1-}" == "--float" ]]; then
  window_class=bspwm-float
  shift
fi
if [[ "${1-}" == "--" ]]; then
  shift
fi
child_command=("$@")

command -v "$terminal" >/dev/null 2>&1 || {
  printf 'bspwm-terminal: no se encontró %s\n' "$terminal" >&2
  exit 127
}

case "${terminal##*/}" in
  alacritty)
    args=(--class "$window_class,$window_class")
    (( ${#child_command[@]} == 0 )) || args+=(-e "${child_command[@]}")
    exec "$terminal" "${args[@]}"
    ;;
  kitty)
    args=(--class "$window_class")
    (( ${#child_command[@]} == 0 )) || args+=("${child_command[@]}")
    exec "$terminal" "${args[@]}"
    ;;
  xterm)
    args=(-name "$window_class")
    (( ${#child_command[@]} == 0 )) || args+=(-e "${child_command[@]}")
    exec "$terminal" "${args[@]}"
    ;;
  *)
    exec "$terminal" "${child_command[@]}"
    ;;
esac
