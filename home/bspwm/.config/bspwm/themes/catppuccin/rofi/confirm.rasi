/** Confirmation dialog for potentially destructive session actions. **/

configuration {
    show-icons: false;
}

@import "shared/colors.rasi"
@import "shared/fonts.rasi"

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 360px;
    border: 0px;
    border-radius: 10px;
    background-color: @background;
}

mainbox {
    spacing: 12px;
    padding: 24px;
    background-color: transparent;
    children: [ inputbar, message, listview ];
}

inputbar {
    background-color: transparent;
    text-color: @foreground;
    children: [ prompt ];
}

prompt {
    padding: 8px 12px;
    border-radius: 8px;
    background-color: @urgent;
    text-color: @background;
}

message {
    padding: 8px;
    background-color: transparent;
    text-color: @foreground;
}

textbox {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
}

listview {
    columns: 2;
    lines: 1;
    cycle: true;
    dynamic: false;
    scrollbar: false;
    layout: vertical;
    spacing: 10px;
    background-color: transparent;
}

element {
    padding: 14px;
    border-radius: 8px;
    background-color: @background-alt;
    text-color: @foreground;
    cursor: pointer;
}

element selected.normal {
    background-color: @selected;
    text-color: @background;
}

element-text {
    font: "Symbols Nerd Font Mono 18";
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
}
